{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"$LOCALAPPDATA/Programs/Exponential/exponential-agent.exe\" hook UserPromptSubmit || exponential-agent hook UserPromptSubmit", "timeout": 5 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "\"$LOCALAPPDATA/Programs/Exponential/exponential-agent.exe\" hook PostToolUse || exponential-agent hook PostToolUse", "timeout": 5 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$LOCALAPPDATA/Programs/Exponential/exponential-agent.exe\" hook Stop || exponential-agent hook Stop", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"$LOCALAPPDATA/Programs/Exponential/exponential-agent.exe\" hook SessionEnd || exponential-agent hook SessionEnd", "timeout": 5 }] }
    ]
  }
}
