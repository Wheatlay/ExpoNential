# Copy to .env. Only DATABASE_URL is needed to start; the rest enables features.
DATABASE_URL=postgres://tracker:tracker@localhost:5434/tracker
PORT=3000
# Public URL: OAuth callback and links in MCP/plugin output.
BASE_URL=http://localhost:5173
# Local login without GitHub (ignored in production): /auth/dev?login=you
DEV_LOGIN=1
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins that become admins on first login.
ADMIN_LOGINS=
# IANA time zone and server-message language (en|pl).
APP_TIMEZONE=UTC
APP_LOCALE=en
# Public demo mode: guest sessions, guided tour, simulated agent, periodic reset.
DEMO_MODE=
DEMO_RESET_MINUTES=60
PUBLIC_REPO_URL=
# Webhooks: GitHub push/deployment_status (/hooks/github), generic deploy (/hooks/deploy).
GITHUB_WEBHOOK_SECRET=
GITHUB_API_TOKEN=
DEPLOY_WEBHOOK_SECRET=
# Optional Coolify deploy source.
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_WEBHOOK_SECRET=
# Web Push (generate with: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
UPLOADS_DIR=data/uploads
LOG_LEVEL=info
